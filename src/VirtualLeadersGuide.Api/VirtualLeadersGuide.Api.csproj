<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VirtualLeadersGuide.Identity.Contracts\VirtualLeadersGuide.Identity.Contracts.csproj" />
    <ProjectReference Include="..\VirtualLeadersGuide.ServiceDefaults\VirtualLeadersGuide.ServiceDefaults.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContainerRepository>virtualleadersguide-api</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <!-- P2-6, #15: Event.Passcode's Data Protection key ring (ADR-0026) persists to the same Blob Storage
         account Web already uses (docs/runbooks/p2-2-blob-dataprotection-keys.md), under its own key file. -->
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="JsonApiDotNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- P2-6, #15: generates Event.Passcode as a memorable two-word phrase (ADR-0027) rather than an opaque
         random token, using the real EFF Large Wordlist. -->
    <PackageReference Include="PasswordGenerator" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Pinned to match Microsoft.Data.SqlClient.Extensions.Azure's version exactly: EF Core SqlServer
         10.0.10 otherwise resolves the core package one patch behind (7.0.1), and that skew makes the
         Active Directory Managed Identity provider fail to load (AmbiguousMatchException from
         SqlAuthenticationProviderManager's reflection-based provider discovery). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
