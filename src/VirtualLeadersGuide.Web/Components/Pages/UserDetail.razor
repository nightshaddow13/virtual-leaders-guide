@page "/dashboard/users/{Id}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@(user?.Email ?? "User")</PageTitle>

<RadzenComponents @rendermode="InteractiveServer" />

@switch (state)
{
    case PageState.Denied:
        <StatusPanel Title="You don't have access to this page" Message="Only Admins can manage Users, or this User doesn't exist.">
            <RadzenButton Text="Back to Users" Click="NavigateToUsers" />
        </StatusPanel>
        break;

    case PageState.Ready:
        <RadzenBreadCrumb>
            <RadzenBreadCrumbItem Text="USERS" Path="dashboard/users" />
            <RadzenBreadCrumbItem Text="@user!.Email?.ToUpperInvariant()" />
        </RadzenBreadCrumb>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Gap="1rem" Style="margin-block: 1rem;">
            <h1>@(user!.DisplayName ?? user.Email)</h1>
            <RadzenBadge Text="@(user.HasCredential ? "ACTIVE" : "INVITED")"
                         BadgeStyle="@(user.HasCredential ? BadgeStyle.Success : BadgeStyle.Warning)" Variant="Variant.Outlined" />
        </RadzenStack>

        @if (statusMessage is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false" Style="margin-block-end: 1rem;" Text="@statusMessage" />
        }
        @if (errorMessage is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Style="margin-block-end: 1rem;" Text="@errorMessage" />
        }

        <div class="vlg-readonly-field">
            <RadzenText TextStyle="TextStyle.Overline">Credential</RadzenText>
            <span>@(user!.HasCredential ? "Set" : "Not set")</span>
        </div>
        <div class="vlg-readonly-field">
            <RadzenText TextStyle="TextStyle.Overline">Role</RadzenText>
            <span>@user.RoleLabel</span>
        </div>
        <div class="vlg-readonly-field">
            <RadzenText TextStyle="TextStyle.Overline">Events</RadzenText>
            <span>@(user.EventGrantCount > 0 ? $"{user.EventGrantCount} assigned" : "None assigned")</span>
        </div>

        @if (!user.HasCredential)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-block-start: 1.5rem;">
                <RadzenButton Text="Resend email" ButtonStyle="ButtonStyle.Light" Click="ResendAsync" Disabled="@isBusy" />
                <RadzenButton Text="Revoke invite" ButtonStyle="ButtonStyle.Danger" Click="RevokeAsync" Disabled="@isBusy" />
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" Style="margin-block-start: 0.5rem;">
                Assign Events from the Event's own Directors section, not from here (ADR-0035).
            </RadzenText>
        }
        break;
}
