@page "/dashboard/events/{EventId:guid}/activities/{ActivityId:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using VirtualLeadersGuide.Web.Activities

<PageTitle>@(activity?.Name ?? "Activity")</PageTitle>

<RadzenComponents @rendermode="InteractiveServer" />

@switch (state)
{
    case PageState.Denied:
        <StatusPanel Title="You don't have access to this Activity"
                     Message="Ask an Admin to grant you access, or check you're signed in as the right person.">
            <RadzenButton Text="Back to dashboard" Click="@(() => NavigationManager.NavigateTo("dashboard", forceLoad: true))" />
        </StatusPanel>
        break;

    case PageState.NotFound:
        <StatusPanel Title="Activity not found" Message="It may have been deleted.">
            <RadzenButton Text="Back to activities" Click="NavigateToList" />
        </StatusPanel>
        break;

    case PageState.Unavailable:
        <StatusPanel Title="Something went wrong loading this page" Message="The store didn't respond. Try again.">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Try again" Click="@(() => NavigationManager.Refresh(forceReload: true))" />
                <RadzenButton Text="Back to dashboard" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("dashboard", forceLoad: true))" />
            </RadzenStack>
        </StatusPanel>
        break;

    case PageState.Ready:
        <NavigationLock ConfirmExternalNavigation="HasUnsavedChanges" />
        <LinkGuard Active="HasUnsavedChanges" />

        <RadzenBreadCrumb>
            <RadzenBreadCrumbItem Text="@(isAdmin ? "EVENTS" : "MY EVENTS")" Path="dashboard" />
            <RadzenBreadCrumbItem Text="@eventName?.ToUpperInvariant()" Path="@($"dashboard/events/{EventId}")" />
            <RadzenBreadCrumbItem Text="ACTIVITIES" Path="@($"dashboard/events/{EventId}/activities")" />
            <RadzenBreadCrumbItem Text="@activity!.Name.ToUpperInvariant()" />
        </RadzenBreadCrumb>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.End" Gap="1rem" Style="margin-block-end: 1rem;">
            <h1>Edit activity</h1>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button"
                              Disabled="@isSaving" Click="NavigateToList" />
                <RadzenButton Text="Save changes" ButtonType="ButtonType.Button"
                              Disabled="@(WriteBlocked || !HasUnsavedChanges)"
                              Click="SubmitAsync" />
            </RadzenStack>
        </RadzenStack>

        @if (permissionLost)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@PermissionLostText" />
        }
        @if (saveErrorMessage is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@saveErrorMessage" />
        }

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeLG="7">
                <fieldset class="ad-editable" disabled="@permissionLost">
                    <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <ActivityDetailsFields Model="form" Changed="OnDetailsChanged" />
                    </EditForm>
                </fieldset>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeLG="5">
                <RadzenStack Gap="1rem">
                    @if (model!.Roots.Count > 0)
                    {
                        <PlacementTree Roots="@model.Roots" IsBusy="@WriteBlocked"
                                       OnRemove="RemoveAsync" OnMove="MoveAsync"
                                       FocusRequest="focusRequest" Announcement="@announcement" />
                    }

                    <fieldset class="ad-editable" disabled="@permissionLost">
                        <PlacementBuilder Model="model" PlacedCount="@PlacedCount" OnPlace="OnPlace" />
                    </fieldset>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        break;
}
