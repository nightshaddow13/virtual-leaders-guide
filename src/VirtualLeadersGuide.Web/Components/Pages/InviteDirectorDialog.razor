@switch (step)
{
    case Step.EnterEmail:
        <EditForm Model="emailModel" OnValidSubmit="ContinueAsync">
            <DataAnnotationsValidator />
            <p>Enter their email. We'll check whether they already have an account.</p>
            <div class="vlg-field">
                <label for="Email">Email</label>
                <InputText id="Email" @bind-Value="emailModel.Email" class="rz-textbox rz-input-md" placeholder="name@example.org" />
                <ValidationMessage For="() => emailModel.Email" class="rz-messages-error" />
            </div>
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div">No event picker here. Assign events afterwards, on the event.</RadzenText>
            @if (errorMessage is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Style="margin-block-start: 0.75rem;" Text="@errorMessage" />
            }
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-block-start: 1rem;">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" Disabled="@isBusy" />
                <RadzenButton Text="Continue" ButtonType="ButtonType.Submit" Disabled="@isBusy" />
            </RadzenStack>
        </EditForm>
        break;

    case Step.NewEmail:
        <p>No account yet for <strong>@emailModel.Email</strong>. Submitting creates their user and emails a password-setup link.</p>
        <div class="vlg-field">
            <label for="DisplayName">Name (optional)</label>
            <input type="text" id="DisplayName" @bind="displayName" class="rz-textbox rz-input-md" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-block-start: 0.5rem;">
            <RadzenBadge Text="DIRECTOR" BadgeStyle="BadgeStyle.Light" Variant="Variant.Outlined" />
            <RadzenBadge Text="NO EVENTS YET" BadgeStyle="BadgeStyle.Light" Variant="Variant.Outlined" />
        </RadzenStack>
        @if (errorMessage is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Style="margin-block-start: 0.75rem;" Text="@errorMessage" />
        }
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-block-start: 1rem;">
            <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Light" Click="@(() => step = Step.EnterEmail)" Disabled="@isBusy" />
            <RadzenButton Text="Send invitation" Click="SendInvitationAsync" Disabled="@isBusy" />
        </RadzenStack>
        break;

    case Step.ExistingUser:
        <p><strong>@emailModel.Email</strong> already exists</p>
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false"
                     Text="No duplicate user is created. Open the existing account instead - it already holds whatever Role/Grants it has." />
        <div style="margin-block-start: 0.75rem;">
            <div>@(existingUser?.DisplayName ?? existingUser?.Email)</div>
            <RadzenText TextStyle="TextStyle.Caption">@existingUser?.Email &middot; @(existingUser?.HasCredential == true ? "Active" : "Invited")</RadzenText>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-block-start: 1rem;">
            <RadzenButton Text="Back" ButtonStyle="ButtonStyle.Light" Click="@(() => step = Step.EnterEmail)" />
            <RadzenButton Text="Open this user" Click="OpenExistingUser" />
        </RadzenStack>
        break;

    case Step.Sent:
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" AllowClose="false"
                     Text="@($"We emailed {emailModel.Email} a link to set a password. They'll have the Director role but no events until you assign some.")" />
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" Style="margin-block-start: 0.5rem;">
            No link is shown here on purpose (ADR-0020) - resend it from the User's page if needed.
        </RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-block-start: 1rem;">
            <RadzenButton Text="Done" Click="@(() => DialogService.Close(true))" />
        </RadzenStack>
        break;
}
