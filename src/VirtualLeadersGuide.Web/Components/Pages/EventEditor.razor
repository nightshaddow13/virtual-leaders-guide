@page "/dashboard/events/new"
@page "/dashboard/events/{Id:guid}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using VirtualLeadersGuide.Web.Directors
@using VirtualLeadersGuide.Web.Events

<PageTitle>@(Id is null ? "New event" : "Event")</PageTitle>

<RadzenComponents @rendermode="InteractiveServer" />

@switch (state)
{
    case PageState.Denied:
        <StatusPanel Title="You don't have access to this Event"
                     Message="Ask an Admin to grant you access, or check you're signed in as the right person.">
            <RadzenButton Text="Back to dashboard" Click="NavigateToDashboard" />
        </StatusPanel>
        break;

    case PageState.Unavailable:
        <StatusPanel Title="Something went wrong loading this Event" Message="The Event store didn't respond. Try again.">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Try again" Click="@(() => NavigationManager.Refresh(forceReload: true))" />
                <RadzenButton Text="Back to dashboard" ButtonStyle="ButtonStyle.Light" Click="NavigateToDashboard" />
            </RadzenStack>
        </StatusPanel>
        break;

    case PageState.Director:
        <RadzenBreadCrumb>
            <RadzenBreadCrumbItem Text="MY EVENTS" Path="dashboard" />
            <RadzenBreadCrumbItem Text="@model!.Name?.ToUpperInvariant()" />
        </RadzenBreadCrumb>
        <div style="margin-block-end: 1rem;">
            <h1>@model!.Name</h1>
            <RadzenBadge Text="VIEW ONLY" BadgeStyle="BadgeStyle.Light" Variant="Variant.Outlined" />
        </div>
        <div class="vlg-readonly-field">
            <RadzenText TextStyle="TextStyle.Overline">Public address</RadzenText>
            <span>/e/@model.Slug</span>
        </div>
        <div class="vlg-readonly-field">
            <RadzenText TextStyle="TextStyle.Overline">Dates</RadzenText>
            <span>@EventDateRange.FormatWithTime(loadedDto?.StartsAt, loadedDto?.EndsAt, viewerZone)</span>
        </div>
        <div class="vlg-readonly-field">
            <RadzenText TextStyle="TextStyle.Overline">Passcode</RadzenText>
            <span>@model.Passcode</span>
        </div>
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false" Style="margin-block-start: 1rem;"
                     Text="No fields, no Save. Need a change? Ask an Admin." />
        break;

    case PageState.Admin:
        <RadzenBreadCrumb>
            <RadzenBreadCrumbItem Text="EVENTS" Path="dashboard" />
            <RadzenBreadCrumbItem Text="@(Id is null ? "NEW" : model!.Name?.ToUpperInvariant())" />
        </RadzenBreadCrumb>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.End" Gap="1rem" Style="margin-block-end: 1rem;">
            <h1>@(Id is null ? "New event" : "Edit event")</h1>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Disabled="@isSaving"
                              Click="NavigateToDashboard" />
                <RadzenButton Text="@(Id is null ? "Create event" : "Save changes")"
                              Disabled="@(isSaving || permissionLostMessage is not null)" Click="SaveAsync" />
            </RadzenStack>
        </RadzenStack>

        @if (permissionLostMessage is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@permissionLostMessage" />
        }
        @if (saveErrorMessage is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@saveErrorMessage" />
        }

        <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="rz-messages-error" role="alert" />
            <fieldset disabled="@(permissionLostMessage is not null)">
                <div class="vlg-field">
                    <label for="Name">Event name</label>
                    <InputText id="Name" @bind-Value="model!.Name" class="rz-textbox rz-input-md" />
                    <ValidationMessage For="() => model!.Name" class="rz-messages-error" />
                </div>
                <div class="vlg-field">
                    <label for="Slug">Event address</label>
                    <div class="vlg-slug-field">
                        <span class="vlg-slug-prefix">/e/</span>
                        <InputText id="Slug" @bind-Value="model!.Slug" class="rz-textbox rz-input-md" />
                    </div>
                    @if (Id is null)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" Style="margin-block-start: 0.25rem;">Leave blank to derive it from the name.</RadzenText>
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" Style="margin-block-start: 0.25rem;">Changing this breaks links already printed in leader packets.</RadzenText>
                    }
                    <ValidationMessage For="() => model!.Slug" class="rz-messages-error" />
                </div>
                <div class="vlg-field">
                    <label for="StartsAt">Starts at</label>
                    <InputDate id="StartsAt" Type="InputDateType.DateTimeLocal" @bind-Value="model!.StartsAtLocal"
                               class="rz-textbox rz-input-md" />
                    <ValidationMessage For="() => model!.StartsAtLocal" class="rz-messages-error" />
                </div>
                <div class="vlg-field">
                    <label for="EndsAt">Ends at</label>
                    <InputDate id="EndsAt" Type="InputDateType.DateTimeLocal" @bind-Value="model!.EndsAtLocal"
                               class="rz-textbox rz-input-md" />
                    <ValidationMessage For="() => model!.EndsAtLocal" class="rz-messages-error" />
                </div>
                <div class="vlg-field">
                    <label for="Passcode">Passcode</label>
                    <InputText id="Passcode" @bind-Value="model!.Passcode" class="rz-textbox rz-input-md" />
                    @if (Id is null)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" Style="margin-block-start: 0.25rem;">Leave blank to generate one.</RadzenText>
                    }
                    <ValidationMessage For="() => model!.Passcode" class="rz-messages-error" />
                </div>
            </fieldset>
        </EditForm>

        @if (Id is not null)
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="margin-block-start: 2rem;">
                <h2>Directors</h2>

                @if (directorsForEvent is { Count: 0 })
                {
                    <RadzenText TextStyle="TextStyle.Body2">No Directors are assigned to this Event yet.</RadzenText>
                }
                else if (directorsForEvent is not null)
                {
                    <div class="vlg-directors-list">
                        @foreach (EventDirectorDto director in directorsForEvent)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                                         AlignItems="AlignItems.Center" Gap="0.5rem">
                                <span>@director.DisplayLabel</span>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenBadge Text="@(director.HasCredential ? "ACTIVE" : "INVITED")"
                                                 BadgeStyle="@(director.HasCredential ? BadgeStyle.Success : BadgeStyle.Warning)" Variant="Variant.Outlined" />
                                    @if (director.IsAdmin)
                                    {
                                        <span @ref="adminGuardAnchors[director.GrantId]"
                                              @onmouseenter="@(() => TooltipService.Open(adminGuardAnchors[director.GrantId], AdminGuardTooltipText))">
                                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                          Size="ButtonSize.ExtraSmall" Disabled="true"
                                                          aria-label="@($"Remove {director.DisplayLabel}")" />
                                        </span>
                                    }
                                    else
                                    {
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                      Size="ButtonSize.ExtraSmall" Disabled="@isRemovingDirector"
                                                      Click="@(() => RemoveDirectorAsync(director))"
                                                      aria-label="@($"Remove {director.DisplayLabel}")" />
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        }
                    </div>
                }

                @if (directorErrorMessage is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@directorErrorMessage" />
                }

                @if (candidateDirectors is { Count: > 0 })
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Style="margin-block-start: 0.5rem;">
                        <RadzenDropDown TValue="string" Data="@candidateDirectors" @bind-Value="selectedDirectorUserId"
                                        TextProperty="@nameof(UserRowDto.Email)" ValueProperty="@nameof(UserRowDto.Id)"
                                        Placeholder="Add an existing Director" Style="min-width: 260px;" />
                        <RadzenButton Text="Add" Click="AddDirectorAsync" Disabled="@(string.IsNullOrEmpty(selectedDirectorUserId) || isAddingDirector)" />
                    </RadzenStack>
                }
                else if (candidateDirectors is not null)
                {
                    <RadzenText TextStyle="TextStyle.Caption">
                        Every current Director already holds this Event, or no one holds the Director Role yet -
                        invite one from the <a href="dashboard/users">Users</a> screen.
                    </RadzenText>
                }
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="margin-block-start: 2rem;">
                <h2>Danger zone</h2>
                <RadzenButton Text="Delete event" ButtonStyle="ButtonStyle.Danger" Disabled="@isDeleting"
                              Click="DeleteAsync" Style="align-self: flex-start;" />
            </RadzenStack>
        }
        break;
}
