@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims

@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>
<p>Placeholder - P2-9 builds the real Admin/Director dashboard here.</p>

@code {
    // A signed-in user's ClaimTypes.Role claims come from ApplicationUserClaimsPrincipalFactory (P2-5, #14),
    // stamped at sign-in from P2-3's UserRole grants. A user holding no grant still redirects to NoAccess.
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        AuthenticationState state = await AuthenticationStateTask;
        bool hasAnyRole = state.User.Claims.Any(c => c.Type == ClaimTypes.Role);

        if (!hasAnyRole)
        {
            NavigationManager.NavigateTo("Account/NoAccess");
        }
    }
}
