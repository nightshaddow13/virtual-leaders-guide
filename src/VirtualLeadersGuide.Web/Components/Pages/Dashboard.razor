@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer

@using VirtualLeadersGuide.Web.Events

<PageTitle>Dashboard</PageTitle>

<RadzenComponents @rendermode="InteractiveServer" />

@if (accessView is not null)
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.End" Gap="1rem" Style="margin-block-end: 1rem;">
        <div>
            <h1>@(accessView.IsAdmin ? "Events" : "My events")</h1>
            <RadzenText TextStyle="TextStyle.Caption">@totalCount events</RadzenText>
        </div>
        @if (accessView.IsAdmin)
        {
            <RadzenButton Text="+ New event" Click="@(() => NavigationManager.NavigateTo("dashboard/events/new"))" />
        }
    </RadzenStack>

    <RadzenDataGrid @ref="grid" TItem="EventDto" Data="@events" Count="@totalCount" LoadData="@LoadDataAsync"
                     AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true"
                     FilterMode="FilterMode.Simple" IsLoading="@isLoading"
                     EmptyText="@(accessView.IsAdmin ? "No Events yet." : "No Events are assigned to you yet.")">
        <Columns>
            <RadzenDataGridColumn TItem="EventDto" Property="@nameof(EventDto.Name)" Title="Name" Filterable="false" />
            <RadzenDataGridColumn TItem="EventDto" Property="@nameof(EventDto.Slug)" Title="Event address" Filterable="false">
                <Template Context="item">/e/@item.Slug</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EventDto" Property="@nameof(EventDto.StartsAt)" Title="Dates" Filterable="false">
                <Template Context="item">@FormatDates(item)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EventDto" Title="Status" Sortable="false" Width="@StatusColumnWidth">
                <Template Context="item">
                    <RadzenBadge Text="@EventStatusDisplay.Text(item.Status)" BadgeStyle="@EventStatusDisplay.Style(item.Status)"
                                 Variant="Variant.Outlined" />
                </Template>
                <FilterTemplate>
                    <RadzenDropDown TValue="EventStatusFilter" Data="@statusFilterOptions" @bind-Value="statusFilter"
                                    TextProperty="Text" ValueProperty="Key" Change="@(_ => grid!.Reload())" />
                </FilterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EventDto" Sortable="false" Filterable="false" Width="@ActionColumnWidth" TextAlign="TextAlign.Center">
                <Template Context="item">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                        <RadzenButton Icon="@(accessView.IsAdmin ? "edit" : "visibility")" ButtonStyle="ButtonStyle.Light"
                                      aria-label="@(accessView.IsAdmin ? "Edit" : "View")"
                                      Click="@(() => NavigationManager.NavigateTo($"dashboard/events/{item.Id}"))" />
                        @if (accessView.IsAdmin)
                        {
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" aria-label="Delete"
                                          Click="@(() => DeleteAsync(item))" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (!accessView.IsAdmin)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false" Style="margin-block-start: 1rem;">
            Directors view Event details, they don't change them &mdash; no <strong>+ New event</strong>, no
            editing the name, address, or passcode. Editing arrives later as Pages and Activities, scoped to
            these Events.
        </RadzenAlert>
    }

    @if (loadErrorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@loadErrorMessage" />
    }

    @if (deleteErrorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Text="@deleteErrorMessage" />
    }
}
