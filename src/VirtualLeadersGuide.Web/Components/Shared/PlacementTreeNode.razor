@using VirtualLeadersGuide.Web.Activities

<div class="ptn-node">
    <div class="ptn-tier ptn-@Node.Kind.ToString().ToLowerInvariant()">
        <span>@Node.Name</span>
        @if (Node.IsPending)
        {
            <span class="ptn-badge">NEW</span>
        }
    </div>

    @if (Node.Children.Count > 0 || Node.Leaves.Count > 0)
    {
        <div class="ptn-children">
            @foreach (PlacementLeaf leaf in Node.Leaves)
            {
                <div class="ptn-leaf @(leaf.IsPending ? "ptn-pending" : leaf.IsThisActivity ? "ptn-lit" : "")">
                    <span>@leaf.ActivityName</span>
                    @if (leaf.IsPending)
                    {
                        <span class="ptn-status">PENDING</span>
                    }
                </div>
            }
            @foreach (TierNode child in Node.Children)
            {
                <PlacementTreeNode Node="child" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public TierNode Node { get; set; } = default!;
}
