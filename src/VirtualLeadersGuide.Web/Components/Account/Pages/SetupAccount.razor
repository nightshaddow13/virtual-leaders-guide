@page "/setup"

<PageTitle>Set your password</PageTitle>

<h1>Set your password</h1>
@if (user is not null)
{
    <h2>@user.Email &mdash; invited as a director</h2>
}
<hr />
<RadzenRow>
    <RadzenColumn Size="12" SizeMD="4">
        <StatusMessage Message="@Message" />
        <EditForm Model="Input" FormName="setup-account" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="rz-messages-error" role="alert" />

            <input type="hidden" name="Input.UserId" value="@Input.UserId" />
            <input type="hidden" name="Input.Code" value="@Input.Code" />
            <div class="vlg-field">
                <label for="Input.Password">Password</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="rz-textbox rz-input-md" autocomplete="new-password" aria-required="true" placeholder="Choose a password" />
                <ValidationMessage For="() => Input.Password" class="rz-messages-error" />
            </div>
            <div class="vlg-field">
                <label for="Input.ConfirmPassword">Confirm password</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="rz-textbox rz-input-md" autocomplete="new-password" aria-required="true" placeholder="Confirm your password" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="rz-messages-error" />
            </div>
            <PrimarySubmitButton Text="Activate account" />
        </EditForm>
    </RadzenColumn>
</RadzenRow>
