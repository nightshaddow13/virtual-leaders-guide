@page "/Account/Login"

@* Trimmed from the scaffold: dropped the passkey sign-in button, "Use another service to log in"
   (ExternalLoginPicker), "Register as a new user" (accounts are invite-only, ADR-0020), "Resend email
   confirmation" (RequireConfirmedAccount is false - see P2-2 plan's Scope), and the RequiresTwoFactor branch
   (unreachable - ApiUserStore doesn't implement IUserTwoFactorStore, see ADR-0022 and issue #54). See
   IdentityRedirectManager.cs's header comment. *@

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>
<RadzenRow>
    <RadzenColumn Size="12" SizeLG="6">
        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <h2>Use a local account to log in.</h2>
                <hr />
                <ValidationSummary class="rz-messages-error" role="alert" />
                <div class="vlg-field">
                    <label for="Input.Email">Email</label>
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="rz-textbox rz-input-md" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <ValidationMessage For="() => Input.Email" class="rz-messages-error" />
                </div>
                <div class="vlg-field">
                    <label for="Input.Password">Password</label>
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="rz-textbox rz-input-md" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <ValidationMessage For="() => Input.Password" class="rz-messages-error" />
                </div>
                <div class="vlg-field">
                    <label>
                        <InputCheckbox @bind-Value="Input.RememberMe" />
                        Remember me
                    </label>
                </div>
                <div>
                    <PrimarySubmitButton Text="Log in" />
                </div>
                <hr />
                <div>
                    <p>
                        <a href="Account/ForgotPassword">Forgot your password?</a>
                    </p>
                </div>
            </EditForm>
        </section>
    </RadzenColumn>
</RadzenRow>
