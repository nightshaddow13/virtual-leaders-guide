@page "/Account/ForgotPassword"

<PageTitle>Forgot your password?</PageTitle>

<h1>Forgot your password?</h1>
<h2>Enter your email.</h2>
<hr />
<RadzenRow>
    <RadzenColumn Size="12" SizeMD="4">
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="rz-messages-error" role="alert" />

            <div class="vlg-field">
                <label for="Input.Email">Email</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="rz-textbox rz-input-md" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="rz-messages-error" />
            </div>
            <PrimarySubmitButton Text="Reset password" />
        </EditForm>
    </RadzenColumn>
</RadzenRow>
