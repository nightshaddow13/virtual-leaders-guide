@page "/Account/ResetPassword"

<PageTitle>Reset password</PageTitle>

<h1>Reset password</h1>
<h2>Reset your password.</h2>
<hr />
<RadzenRow>
    <RadzenColumn Size="12" SizeMD="4">
        <StatusMessage Message="@Message" />
        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="rz-messages-error" role="alert" />

            <input type="hidden" name="Input.Code" value="@Input.Code" />
            <div class="vlg-field">
                <label for="Input.Email">Email</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="rz-textbox rz-input-md" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" class="rz-messages-error" />
            </div>
            <div class="vlg-field">
                <label for="Input.Password">Password</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="rz-textbox rz-input-md" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
                <ValidationMessage For="() => Input.Password" class="rz-messages-error" />
            </div>
            <div class="vlg-field">
                <label for="Input.ConfirmPassword">Confirm password</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="rz-textbox rz-input-md" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
                <ValidationMessage For="() => Input.ConfirmPassword" class="rz-messages-error" />
            </div>
            <PrimarySubmitButton Text="Reset" />
        </EditForm>
    </RadzenColumn>
</RadzenRow>
