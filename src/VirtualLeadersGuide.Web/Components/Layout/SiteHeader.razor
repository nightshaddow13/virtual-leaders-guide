@* See ADR-0034 for why every control here is a real <a>/<form>, never a Radzen component. *@

<header class="vlg-header">
    <div class="vlg-brand-row">
        <a class="vlg-brand" href="">
            <span class="vlg-logo-mark" aria-hidden="true"></span>
            <span class="vlg-brand-text">Virtual Leaders Guide</span>
        </a>

        <div class="vlg-header-actions">
            <button type="button" id="vlg-theme-toggle" class="vlg-theme-toggle" aria-label="Toggle color theme">
                <svg class="vlg-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
                <svg class="vlg-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
            </button>

            <AuthorizeView>
                <Authorized>
                    <nav class="vlg-account-actions" aria-label="Account">
                        <NavLink class="rz-button rz-button-sm rz-variant-text rz-base rz-shade-default"
                                 href="Account/Manage">
                            <span class="rz-button-box"><span class="rz-button-text">Manage account</span></span>
                        </NavLink>
                        <SignOutForm />
                    </nav>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="rz-button rz-button-md rz-variant-outlined rz-primary rz-shade-default vlg-signin"
                             href="Account/Login">
                        <span class="rz-button-box"><span class="rz-button-text">Staff sign in</span></span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <SignedInContextStrip />
</header>
