@inject NavigationManager NavigationManager

@* See ADR-0034 for why this is a real form post, not a RadzenButton. *@

<form action="Account/Logout" method="post">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
    <button type="submit" class="@NavButton.Classes() @NavButton.MenuItem rz-w-100">
        <span class="rz-button-box"><span class="rz-button-text">Sign out</span></span>
    </button>
</form>

@code {
    private string? currentUrl;

    /// <remarks>
    /// Read once per render rather than tracked via <c>NavigationManager.LocationChanged</c>: the layout renders
    /// statically even around an interactive page, and each navigation renders it again.
    /// </remarks>
    protected override void OnInitialized() =>
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
}
