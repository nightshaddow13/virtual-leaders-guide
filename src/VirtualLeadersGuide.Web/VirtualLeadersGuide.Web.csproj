<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ContainerRepository>virtualleadersguide-web</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualLeadersGuide.Identity.Contracts\VirtualLeadersGuide.Identity.Contracts.csproj" />
    <ProjectReference Include="..\VirtualLeadersGuide.ServiceDefaults\VirtualLeadersGuide.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <!-- Mints the internal JWT (P2-5, #14) with the same token-handling stack
         Microsoft.AspNetCore.Authentication.JwtBearer uses on the Api side to validate it. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

</Project>
